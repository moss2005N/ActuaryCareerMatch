# Django
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: SQLite is used when DB_ENGINE is omitted or set to sqlite.
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# Optional PostgreSQL settings (requires psycopg).
# DB_ENGINE=postgresql
# DB_NAME=actuary_career_match
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Email (console output is the safe local default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL="Actuary Career Match <noreply@localhost>"
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False

# Phone verification (Twilio is never contacted unless explicitly selected)
PHONE_VERIFICATION_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

OTP_EXPIRY_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
